# Copia este archivo a .env y cambia las claves.
# cp .env.example .env

# URL con la que se entra al taller (sin barra final).
# IP del VPS:  http://192.168.1.20
# Dominio:     https://taller.midominio.com
# Si HTTP_PORT no es 80, incluye el puerto: http://192.168.1.20:8080
PUBLIC_URL=http://localhost
HTTP_PORT=80

# PostgreSQL (solo dentro de Docker; no se publica al exterior).
# En DB_PASSWORD no uses los caracteres @ : / — rompen la URL de conexión.
DB_USER=lyer
DB_PASSWORD=cambia-esta-clave
DB_NAME=lyer_motors

# Firma de JWT. Genera uno: openssl rand -hex 64
JWT_SECRET=cambia-este-secreto-largo

# true = seed siempre (pisa usuarios de prueba)
# false = nunca
# if-empty = solo si la base no tiene usuarios (recomendado)
RUN_SEED=if-empty

# Consulta DNI/RUC. Si el token está vacío, el nombre se completa a mano.
APISPERU_BASE_URL=https://dniruc.apisperu.com/api/v1
APISPERU_TOKEN=

# Hilos de CPU para el YOLO. En un VPS pequeño usa 1 o 2.
OMP_NUM_THREADS=2
