generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// USUARIOS Y ROLES
// ==========================================
model Usuario {
  id                 Int            @id @default(autoincrement())
  username           String         @unique
  password           String
  nombreCompleto     String?
  rol                Rol            @default(RECEPCIONISTA)
  activo             Boolean        @default(true)
  ordenesCreadas     OrdenTrabajo[] @relation("Creador")
  ordenesResponsable OrdenTrabajo[] @relation("Responsable")
  logs               LogActividad[]
}

enum Rol {
  ADMIN
  SUPERVISOR
  TECNICO
  RECEPCIONISTA
}

// ==========================================
// CLIENTES, MARCAS Y VEHÍCULOS
// ==========================================
model Cliente {
  id                Int            @id @default(autoincrement())
  tipoCliente       TipoCliente
  tipoDocumento     TipoDocumento
  numeroDocumento   String         @unique // DNI o RUC
  nombreRazonSocial String
  representante     String? // Chofer, trabajador o persona que deja el vehículo
  celular           String?
  correo            String?
  actualizadoAt     DateTime       @updatedAt
  ordenes           OrdenTrabajo[]
}

enum TipoCliente {
  PERSONA
  EMPRESA
}

enum TipoDocumento {
  DNI
  RUC
}

model MarcaVehiculo {
  id        Int        @id @default(autoincrement())
  nombre    String     @unique
  vehiculos Vehiculo[]
}

model Vehiculo {
  placa         String         @id
  marcaId       Int
  marca         MarcaVehiculo  @relation(fields: [marcaId], references: [id])
  modelo        String
  horometro     Float?         @default(0)
  kilometraje   Float?         @default(0)
  actualizadoAt DateTime       @updatedAt
  ordenes       OrdenTrabajo[]
}

// ==========================================
// ÓRDENES DE TRABAJO
// ==========================================
enum EstadoIngreso {
  ACEPTADO
  OBSERVADO
}

enum EstadoOrden {
  EN_ESPERA // Borrador creado por recepcionista
  ACEPTADO // Validado por supervisor/admin, listo para rellenar
  EN_REPARACION
  CAMBIO_ACEITE
  ESPERANDO_REPUESTO
  TERMINADO
  CANCELADO
}

model OrdenTrabajo {
  id          Int      @id @default(autoincrement())
  numeroOrden String   @unique
  fechaCreacion DateTime @default(now())

  // Relaciones Principales
  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  placa     String
  vehiculo  Vehiculo @relation(fields: [placa], references: [placa])

  // Descripciones del Trabajo
  descripcionInformal String? @db.Text // Lo que dicta el cliente/recepcionista
  trabajoSolicitado   String? @db.Text // Descripción profesional del trabajo a realizar

  // Condiciones de Ingreso
  estadoIngreso      EstadoIngreso @default(ACEPTADO)
  observacionIngreso String?       @db.Text // Obligatorio si el estado es OBSERVADO

  // Evidencia Fotográfica
  fotoRegistro   String? // Inmutable. Se toma al crear la orden.
  fotoDesarrollo String? // Mutable. Se sobreescribe durante el proceso.

  // Estado y Flujo
  estado      EstadoOrden @default(EN_ESPERA)
  estaCerrada Boolean     @default(false)

  // Facturación y Cierre
  requiereFactura Boolean  @default(false)
  numeroFactura   String?
  montoFactura    Decimal? @db.Decimal(10, 2)

  // Responsables
  creadorId     Int
  creador       Usuario  @relation("Creador", fields: [creadorId], references: [id])
  responsableId Int? // Opcional al inicio, asignado por Supervisor
  responsable   Usuario? @relation("Responsable", fields: [responsableId], references: [id])

  // Sub-detalles e Historial
  materiales OTMaterial[]
  servicios  OTServicio[]
  terceros   OTTercero[]
  totalFinal Decimal        @default(0) @db.Decimal(10, 2)
  logs       LogActividad[]
}

model ContadorOrden {
  id        Int      @id @default(autoincrement())
  anio      Int      @unique
  contador  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ==========================================
// CATÁLOGOS E INVENTARIO
// ==========================================
model CatalogoMaterial {
  id            Int          @id @default(autoincrement())
  descripcion   String
  precioBase    Decimal      @db.Decimal(10, 2)
  actualizadoAt DateTime     @updatedAt
  detalles      OTMaterial[]
}

model CatalogoServicio {
  id            Int          @id @default(autoincrement())
  descripcion   String
  precioBase    Decimal      @db.Decimal(10, 2)
  actualizadoAt DateTime     @updatedAt
  detalles      OTServicio[]
}

model CatalogoTercero {
  id            Int         @id @default(autoincrement())
  descripcion   String
  responsable   String? // Nombre de la empresa o persona que hace este servicio externo
  precioBase    Decimal     @db.Decimal(10, 2)
  actualizadoAt DateTime    @updatedAt
  detalles      OTTercero[]
}

// ==========================================
// DETALLES DE LA ORDEN
// ==========================================
model OTMaterial {
  id             Int              @id @default(autoincrement())
  ordenId        Int
  orden          OrdenTrabajo     @relation(fields: [ordenId], references: [id])
  materialId     Int
  material       CatalogoMaterial @relation(fields: [materialId], references: [id])
  cantidad       Decimal          @db.Decimal(10, 2)
  precioAplicado Decimal?         @db.Decimal(10, 2)
}

model OTServicio {
  id          Int              @id @default(autoincrement())
  ordenId     Int
  orden       OrdenTrabajo     @relation(fields: [ordenId], references: [id])
  servicioId  Int
  servicio    CatalogoServicio @relation(fields: [servicioId], references: [id])
  descripcion String
  monto       Decimal?         @db.Decimal(10, 2)
}

model OTTercero {
  id          Int             @id @default(autoincrement())
  ordenId     Int
  orden       OrdenTrabajo    @relation(fields: [ordenId], references: [id])
  terceroId   Int
  tercero     CatalogoTercero @relation(fields: [terceroId], references: [id])
  descripcion String
  monto       Decimal?        @db.Decimal(10, 2)
}

// ==========================================
// AUDITORÍA
// ==========================================
model LogActividad {
  id        Int           @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])
  ordenId   Int?
  orden     OrdenTrabajo? @relation(fields: [ordenId], references: [id])
  accion    String
  detalles  Json?
  ipCliente String?
  userAgent String?
  fecha     DateTime      @default(now())

  @@index([usuarioId])
  @@index([ordenId])
  @@index([fecha])
}
